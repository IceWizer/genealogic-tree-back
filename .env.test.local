###> symfony/framework-bundle ###
APP_NAME="GenealogicTree"
APP_URL="http://localhost"
APP_ENV=dev
APP_DEBUG=1
APP_SECRET="Not24get"
APP_IV="0123456789abcdef"
###< symfony/framework-bundle ###

# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'

SYMFONY_DEPRECATIONS_HELPER=999999

PANTHER_APP_ENV=panther
PANTHER_ERROR_SCREENSHOT_DIR=./var/error-screenshots

MYSQL_ROOT_PASSWORD=Not24get
MYSQL_USER=genealogic-tree
MYSQL_PASSWORD=Not24get
MYSQL_DATABASE=genealogic-tree
MYSQL_VERSION=9.4

SERVER_NAME=localhost

MESSENGER_TRANSPORT_DSN="doctrine://default"
MAILER_DSN=smtp://mailpit:1025
MAIL_FROM="Name <no-reply@example.com"

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=
# 1 week
JWT_TTL=604800
###< lexik/jwt-authentication-bundle ###

DATABASE_URL=mysql://${MYSQL_USER:-root}:${MYSQL_PASSWORD:-root}@db:${MYSQL_PORT:-3306}/${MYSQL_DATABASE:-symfony}?serverVersion=${MYSQL_VERSION:-5.7}

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='*'
###< nelmio/cors-bundle ###

XDEBUG_MODE=coverage
